{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "allike",
  "main": "worker/independent.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "vars": {
    "AUTH_PROVIDER": "admin",
    "DEPLOYMENT_TARGET": "independent"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "allike-db",
      "database_id": "be8f3aa6-85ed-446e-af19-e6516584a5ab",
      "migrations_dir": "drizzle"
    }
  ]
}
