# Configure em .dev.vars para desenvolvimento; não versionar valores reais.
STEAM_API_KEY=
LASTFM_API_KEY=
TOKEN_SECRET=

# Administrador: preencha usuário e hash. Para cadastro por e-mail, use supabase após configurar confirmação e envio de e-mails.
AUTH_PROVIDER=admin
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
